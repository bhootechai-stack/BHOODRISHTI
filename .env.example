# ==============================================================================
# Krishi Mitra AI (Bhoodrishti) — Environment Configuration Template
# All keys must be pre-configured on the server / environment. Users are never prompted in the UI.
# ==============================================================================

# Gemini AI API Key (Required for server-side agro-climatic agronomy synthesis)
GEMINI_API_KEY=""

# Application Host URL (Injected automatically in Cloud Run / hosting environments)
APP_URL=""

# Google Maps API Key (Optional — For custom Google Maps satellite tile rendering)
# (Pure Leaflet high-res satellite & Esri World Imagery activates automatically if omitted)
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

# Supabase Project Credentials (Persistent Database, Mandi Cache, Field Boundaries)
# (Resilient local file database & IndexedDB activate automatically if omitted)
# Supported variable names:
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_ANON_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-Only Supabase Service Role Key (NEVER expose to client/browser!)
# Provides privileged backend database writes when Row Level Security (RLS) is enabled.
# Obtained from: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=""

# Copernicus Data Space Ecosystem / Sentinel Hub Credentials (Optional)
# (Free Copernicus Open Web Services S2 Earth Observation activates automatically if omitted)
SENTINEL_HUB_CLIENT_ID=""
SENTINEL_HUB_CLIENT_SECRET=""
SENTINEL_HUB_INSTANCE_ID=""
VITE_SENTINEL_HUB_CLIENT_ID=""
VITE_SENTINEL_HUB_CLIENT_SECRET=""
VITE_SENTINEL_HUB_INSTANCE_ID=""
VITE_COPERNICUS_CLIENT_ID=""
VITE_COPERNICUS_CLIENT_SECRET=""
VITE_COPERNICUS_INSTANCE_ID=""
